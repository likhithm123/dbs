<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="java.util.*" %>
<% Map<String,String> tables=(Map<String,String>)request.getAttribute("tables"); List<String> columns=(List<String>)request.getAttribute("columns"); List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("rows"); List<String> formColumns=(List<String>)request.getAttribute("formColumns"); String chosen=(String)request.getAttribute("chosen"); String error=(String)request.getAttribute("error"); String notice=(String)session.getAttribute("notice"); session.removeAttribute("notice"); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Campus Event Manager</title><style>
:root{font-family:Arial,sans-serif;color:#182230;background:#f5f7fa}*{box-sizing:border-box}body{margin:0}.top{background:#172b4d;color:white;padding:22px 28px}.top h1{margin:0 0 6px;font-size:24px}.top p{margin:0;color:#cbd5e1}.layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:20px;max-width:1400px;margin:22px auto;padding:0 18px}.nav,.panel{background:white;border:1px solid #e2e8f0;border-radius:9px}.nav{padding:12px;height:max-content}.nav a{display:block;color:#334155;text-decoration:none;padding:11px;border-radius:6px;margin:2px 0}.nav a.active,.nav a:hover{background:#eaf1ff;color:#1746a2}.content{min-width:0}.panel{padding:18px;margin-bottom:18px}.panel h2{font-size:18px;margin:0 0 14px}.bar{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}.muted{color:#64748b;font-size:13px}.alert{padding:11px;border-radius:6px;background:#eff6ff;margin-bottom:15px;overflow-wrap:anywhere}.error{background:#fff1f2;color:#9f1239}.form{display:grid;grid-template-columns:repeat(3,minmax(150px,1fr));gap:12px}.field label{display:block;font-size:12px;color:#475569;margin-bottom:6px}.field input{width:100%;padding:10px;border:1px solid #cbd5e1;border-radius:5px}.btn{background:#1d4ed8;color:white;border:0;border-radius:5px;padding:10px 14px;cursor:pointer}.btn.danger{background:#b91c1c}.tablewrap{overflow:auto}table{border-collapse:collapse;width:100%;font-size:13px}th,td{text-align:left;border-bottom:1px solid #e2e8f0;padding:11px;white-space:nowrap}th{background:#f8fafc;color:#475569}.inline{display:inline}.empty{padding:25px;text-align:center;color:#64748b}@media(max-width:800px){.layout{grid-template-columns:1fr}.nav{display:flex;flex-wrap:wrap}.nav a{padding:8px}.form{grid-template-columns:1fr 1fr}}@media(max-width:500px){.form{grid-template-columns:1fr}}
</style></head><body><header class="top"><h1>Campus Event & Resource Management</h1><p>Database Systems Lab · Events, venues, sessions, registrations and resources</p></header><div class="layout"><nav class="nav"><div class="muted" style="padding:8px 10px">MANAGEMENT</div><% for(Map.Entry<String,String> item:tables.entrySet()){ %><a class="<%=item.getKey().equals(chosen)?"active":""%>" href="?table=<%=item.getKey()%>"><%=item.getKey()%></a><% } %></nav><main class="content">
<% if(notice!=null){ %><div class="alert"><%=notice%></div><% } %><% if(error!=null){ %><div class="alert error"><strong>Database connection/query issue:</strong> <%=error%><br><span class="muted">Check DB_TYPE, DB_URL, DB_USER, DB_PASSWORD and run the matching schema SQL script.</span></div><% } %>
<section class="panel"><div class="bar"><div><h2><%=chosen%></h2><div class="muted">Showing up to 100 records from <%=tables.get(chosen)%>.</div></div><button class="btn" onclick="document.getElementById('createform').scrollIntoView({behavior:'smooth'})">+ Add record</button></div><div class="tablewrap" style="margin-top:15px"><table><thead><tr><% for(String col:columns){ %><th><%=col%></th><% } %><th>Action</th></tr></thead><tbody><% if(rows.isEmpty()){ %><tr><td colspan="<%=columns.size()+1%>" class="empty">No records to display.</td></tr><% } for(Map<String,Object> row:rows){ %><tr><% for(String col:columns){Object val=row.get(col); %><td><%=val==null?"—":val%></td><% } %><td><form class="inline" method="post" onsubmit="return confirm('Delete this record? Related records may prevent deletion.')"><input type="hidden" name="table" value="<%=chosen%>"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=row.get(columns.get(0))%>"><button class="btn danger" type="submit">Delete</button></form></td></tr><% } %></tbody></table></div></section>
<section class="panel" id="createform"><h2>Add <%=chosen.substring(0,chosen.length()-1)%></h2><p class="muted">Enter the columns below. Foreign-key values must already exist in their parent tables.</p><form method="post"><input type="hidden" name="table" value="<%=chosen%>"><input type="hidden" name="action" value="create"><div class="form"><% for(String col:formColumns){ %><div class="field"><label for="f_<%=col%>"><%=col%></label><input id="f_<%=col%>" name="<%=col%>" placeholder="Enter <%=col%>" <%=col.endsWith("_id")?"inputmode=\"numeric\"":""%>></div><% } %></div><p><button class="btn" type="submit">Save record</button></p></form></section>
<section class="panel"><h2>Database setup</h2><p class="muted">Java Servlet + JSP + JDBC. Select MySQL or Oracle using environment variables; credentials are never stored in the source code.</p><code>DB_TYPE=mysql</code> · <code>DB_URL=jdbc:mysql://localhost:3306/campus_events</code><br><code>DB_TYPE=oracle</code> · <code>DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1</code></section>
</main></div></body></html>